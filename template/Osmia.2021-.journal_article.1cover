layout.caption.aboveTable	true
layout.caption.belowFigure	true
layout.caption.figureStartPatterns	(Fig(ure)?(s)?|FIG(URE)?(S)?|Map(s)?|MAP(S)?|Carte(s)?|CARTE(S)?)\.?
